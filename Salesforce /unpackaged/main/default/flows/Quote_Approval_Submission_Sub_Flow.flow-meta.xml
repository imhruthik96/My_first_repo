                <leftValueReference>Regional_Manager_Approval_Stepp.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <label>Regional_Manager Approved</label>
        </rules>
        <rules>
            <name>Regional_Manager_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Regional_Manager_Approval_Stepp.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <label>Regional Manager Rejected</label>
        </rules>
    </decisions>
