    <decisions>
        <description>Determine Approval Level</description>
        <name>Determine_Approval_Level</name>
        <label>Determine Approval Level</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Manager_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Approval_Data.Outputs.Discount_Percentage</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Quote_Approval_Data.Outputs.Discount_Percentage</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Manager_Approval_Stage</targetReference>
            </connector>
            <label>Manager Approval</label>
        </rules>
        <rules>
            <name>Regional_Manager_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Approval_Data.Outputs.Discount_Percentage</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Regional_Manager_Approval_Step</targetReference>
            </connector>
            <label>Regional Manager Approval</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determine whether the Manager approved or rejected the Quote.</description>
        <name>Manager_Approval_Result</name>
        <label>Manager Approval Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Manager_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Manager_Approval_Step.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <label>Manager Approved</label>
        </rules>
        <rules>
            <name>Manager_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Manager_Approval_Step.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <label>Manager Rejected</label>
        </rules>
    </decisions>
    <decisions>
        <description>Regional Manager Approval Result</description>
        <name>Regional_Manager_Approval_Result</name>
        <label>Regional Manager Approval Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
